---
layout: base.njk
eleventyExcludeFromCollections: true
---
{% set featured = collections.posts | limit(1) %}
{% set sideposts = collections.posts | after(1) | limit(3) %}
{% set rest = collections.posts | after(4) | limit(6) %}

<section class="hero">
  <div class="wrap hero-grid">
    {% for post in featured %}
    <article class="lead {{ post.data.category | catColor }}">
      <span class="chip">{{ post.data.category }}</span>
      <h1><a href="{{ post.url }}">{{ post.data.title }}</a></h1>
      <p>{{ post.data.dek }}</p>
      <div class="meta">{{ post.data.author or "Redacția Cleaning Journal" }} · {{ post.date | dataRo }}</div>
    </article>
    {% endfor %}
    <div class="side">
      {% for post in sideposts %}
      <a href="{{ post.url }}" class="scard">
        <span class="thumb {{ post.data.category | catColor }}"></span>
        <div>
          <span class="k">{{ post.data.category }}</span>
          <h3>{{ post.data.title }}</h3>
          <span class="m">{{ post.date | dataRo }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-head">
      <h2><span></span>Cele mai recente articole</h2>
    </div>
    <div class="grid3">
      {% for post in rest %}
      <article class="card">
        <a href="{{ post.url }}" class="cover {{ post.data.category | catColor }}"><span class="tag">{{ post.data.category }}</span></a>
        <div class="body">
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.dek }}</p>
          <div class="foot">{{ post.data.author or "Redacția" }}<span class="dot"></span>{{ post.date | dataRo }}</div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap sec">
    <div class="sec-head"><h2><span></span>Explorează pe categorii</h2></div>
    <div class="cats">
      <a href="/categorie/echipamente/" class="cat">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="11" rx="2" stroke="#c9a24b" stroke-width="1.6"/><path d="M7 7V5h10v2M8 18v2M16 18v2" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <h4>Echipamente</h4>
        <p>Mașini de spălat-aspirat, monodiscuri, aspiratoare industriale.</p>
      </a>
      <a href="/categorie/produse/" class="cat">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none"><path d="M9 3h6v4l3 6a4 4 0 0 1-4 5h-4a4 4 0 0 1-4-5l3-6V3Z" stroke="#c9a24b" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 3h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <h4>Produse &amp; chimie</h4>
        <p>Detergenți, dezinfectanți, dozare, pH și fișe de siguranță.</p>
      </a>
      <a href="/categorie/metode-de-lucru/" class="cat">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none"><path d="M4 20l4-1 9-9-3-3-9 9-1 4Z" stroke="#c9a24b" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 7l3 3" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <h4>Metode de lucru</h4>
        <p>Protocoale, coduri de culori și bune practici de curățenie.</p>
      </a>
      <a href="/categorie/facility-management/" class="cat">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="#c9a24b" stroke-width="1.6"/><path d="M8 4v16M4 12h4M14 8h4M14 12h4M14 16h4" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/></svg></span>
        <h4>Facility management</h4>
        <p>Contracte, planificare și management operațional.</p>
      </a>
    </div>
  </div>
</section>
